# ==============================================================================
# APPLICATION LOCAL CONFIGURATION TEMPLATE (application-local.properties.example)
# ==============================================================================
# Hướng dẫn: Copy file này thành "application-local.properties" (file này được .gitignore bảo vệ)
# để cấu hình thông tin kết nối cơ sở dữ liệu và API keys môi trường máy cục bộ của bạn.
# ==============================================================================

# Database Configuration (MySQL)
spring.datasource.url=jdbc:mysql://localhost:3306/room_rental_management?useUnicode=true&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=Asia/Ho_Chi_Minh
spring.datasource.username=root
spring.datasource.password=your_db_password_here

# Cloudinary Configuration (Lưu trữ ảnh Cloud)
cloudinary.cloud-name=your_cloud_name
cloudinary.api-key=your_api_key
cloudinary.api-secret=your_api_secret

# Super Admin Phone & JWT Config (Tùy chọn ghi đè nếu cần)
# app.security.root-phone=0779637353
# app.security.jwt.secret=your_base64_encoded_256bit_jwt_secret_key
