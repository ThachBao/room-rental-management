# ==============================================================================
# ROOM RENTAL MANAGEMENT - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Hướng dẫn: 
# 1. Để chạy Backend Spring Boot với biến môi trường (.env), copy file này thành ".env"
# 2. Hoặc cấu hình các biến môi trường này trên dịch vụ Cloud / Docker / CI/CD.
# ==============================================================================

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/room_rental_management?useUnicode=true&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# Server Port
PORT=8080

# Super Admin Phone
ROOT_PHONE=0779637353

# JWT Security Configuration
JWT_SECRET=dGhpcy1pcy1hLXN1cGVyLXNlY3JldC1rZXktZm9yLWp3dC10b2tlbi1nZW5lcmF0aW9uLXdpdGgtMjU2LWJpdHMta2V5LXNpemU=
JWT_EXPIRATION=86400000

# Cloudinary Storage API Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
